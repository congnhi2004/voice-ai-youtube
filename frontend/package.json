    "@heroui/react": "^3.0.4",
    "@heroui/styles": "^3.0.4",
    "@internationalized/date": "^3.12.1",
    "@prisma/client": "^6.6.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-pacer": "^0.22.0",
    "@tanstack/react-query": "^5.100.9",
    "better-auth": "^1.6.10",
    "bowser": "^2.14.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "^15.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
